@model CareerConnect.Models.CompanyMV
@{
    ViewBag.Title = "Create Company";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/company-create.css" />
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Company</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "Company", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.CompanyName, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.CompanyName, new { @class = "form-control", placeholder = "Enter company name" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.ContactNo, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.ContactNo, new { @class = "form-control", placeholder = "Enter contact number" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.PhoneNo, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.PhoneNo, new { @class = "form-control", placeholder = "Enter phone number" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.EmailAddress, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Enter email address" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.Label("Logo (Upload Image)", new { @class = "form-label fw-bold" })
                            <input type="file" name="LogoFile" class="form-control" />
                        </div>

                        <div class="form-group mb-4">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, placeholder = "Enter company description" })
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
