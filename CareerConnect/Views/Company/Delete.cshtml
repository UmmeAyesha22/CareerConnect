@model DatabaseLayer.CompanyTable
@{
    ViewBag.Title = "Delete Company";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/company-delete.css" />
}
<div class="main-container">
    <div class="professional-card">
        <div class="card-header-custom">
            <h4>Delete Company</h4>
        </div>

        <div class="card-body-custom">
            <h5 class="mb-3">Are you sure you want to delete this company?</h5>
            <hr />

            <dl class="row mb-4">
                <dt class="col-sm-3">Logo</dt>
                <dd class="col-sm-9">
                    <img src="@Url.Content(Model.Logo)" alt="Logo" width="100" class="rounded" />
                </dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.CompanyName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.EmailAddress</dd>

                <dt class="col-sm-3">Contact</dt>
                <dd class="col-sm-9">@Model.ContactNo</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.PhoneNo</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Company", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CompanyID)

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-delete btn-lg">Delete</button>
                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-cancel btn-lg" })
                </div>
            }
        </div>
    </div>
</div>
