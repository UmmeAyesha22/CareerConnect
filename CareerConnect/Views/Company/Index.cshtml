@model IEnumerable<DatabaseLayer.CompanyTable>
@{
    ViewBag.Title = "Companies";
}


@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/company-table.css" />
}
<div class="companies-container">
    <h2 class="page-title">Companies</h2>

    <div class="table-responsive">
        <table class="companies-table">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Contact</th>
                    <th>Phone</th>
                    <th>Description</th>
                    <th class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@Url.Content(item.Logo)" alt="Logo" class="company-logo" />
                        </td>
                        <td>@item.CompanyName</td>
                        <td>@item.EmailAddress</td>
                        <td>@item.ContactNo</td>
                        <td>@item.PhoneNo</td>
                        <td>@item.Description</td>
                        <td class="actions-col">
                            @if (Session["UserTypeID"] != null)
                            {
                                int userType = (int)Session["UserTypeID"];
                                if (userType == 1 || userType == 2)
                                {
                                    @Html.ActionLink("Edit", "Edit", new { id = item.CompanyID }, new { @class = "btn btn-sm btn-edit" })
                                    @Html.ActionLink("Delete", "Delete", new { id = item.CompanyID }, new { @class = "btn btn-sm btn-delete" })
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
