@model DatabaseLayer.CountryTable

@{
    ViewBag.Title = "Delete Country";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/country-delete.css" />
}

<div class="jobs-container">
    <!-- Decorative background shapes -->
    <div class="bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
    </div>

    <div class="container py-5 d-flex justify-content-center">
        <div class="col-lg-6">
            <!-- Delete Confirmation Card -->
            <div class="job-card text-center">
                <h3 class="job-title mb-3">Delete Country</h3>
                <p class="text-muted mb-4">Are you sure you want to delete this country?</p>

                <div class="mb-3">
                    <h5 class="text-secondary">Country Name</h5>
                    <p class="fw-bold">@Html.DisplayFor(model => model.Country)</p>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <input type="submit" value="Delete" class="btn btn-apply" />
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-details" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>