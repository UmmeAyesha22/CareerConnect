@model IEnumerable<DatabaseLayer.CountryTable>

@{
    ViewBag.Title = "Countries";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/country-index.css" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header Card -->
            <div class="filter-card d-flex justify-content-between align-items-center mb-4">
                <h3 class="filter-title mb-0">All Countries</h3>
                @Html.ActionLink("New Country", "Create", null, new { @class = "btn btn-primary" })
            </div>

            <!-- Countries Table Card -->
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Country</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    int count = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@count</td>
                                            <td>@Html.DisplayFor(modelItem => item.Country)</td>
                                            <td>
                                                @Html.ActionLink("Edit", "Edit", new { id = item.CountryID }, new { @class = "btn btn-sm btn-primary me-2" })
                                                @Html.ActionLink("Delete", "Delete", new { id = item.CountryID }, new { @class = "btn btn-sm btn-danger" })
                                            </td>
                                        </tr>
                                        count++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">No countries found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>