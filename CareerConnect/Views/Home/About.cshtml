@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "About Us";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/About.css" />
}

<div class="profile-container">
    <!-- Background Shapes -->
    <div class="bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
    </div>

    <!-- About Section -->
    <div class="profile-card">
        <div class="card-header">
            <h2 class="card-title">About Career Connect</h2>
        </div>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <div>
                    <div class="info-label">Our Vision</div>
                    <div class="info-value">
                        Empower job seekers and organizations through innovative solutions,
                        bridging the gap between talent and opportunity.
                    </div>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <div>
                    <div class="info-label">Our Mission</div>
                    <div class="info-value">
                        Deliver seamless recruitment experiences with accuracy,
                        speed, and professionalism.
                    </div>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <div class="info-label">Who We Are</div>
                    <div class="info-value">
                        A global job portal connecting talented individuals with
                        top employers worldwide.
                    </div>
                </div>
            </div>
        </div>

        <!-- Call to Action Buttons -->
        <div class="action-buttons">
            <button class="btn btn-primary">Explore Jobs</button>
            <button class="btn btn-outline">Contact Us</button>
        </div>
    </div>
</div>
<style>
    /* ===== Header Buttons Round Style ===== */
    .head-btn1,
    .head-btn2 {
        border-radius: 50px;
        font-weight: 700;
        padding: 18px 42px;
        border: none;
        font-size: 1.1rem;
        color: #fff;
        background: #b9a8f5;
        box-shadow: 0 6px 18px rgba(185, 168, 245, 0.35);
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        margin-left: 10px;
        text-align: center;
    }

        .head-btn1:hover,
        .head-btn2:hover {
            background: #a38ce8;
            box-shadow: 0 8px 24px rgba(163, 140, 232, 0.45);
            transform: translateY(-2px);
        }

</style>