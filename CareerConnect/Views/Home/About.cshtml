@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "About Us";
}

<section class="about-section section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12 mb-4">
                <h2 class="section-title">About Career Connect</h2>
                <p>
                    Career Connect is a leading job portal connecting talented individuals
                    with top employers worldwide. Our mission is to simplify job searching
                    and hiring with advanced tools and resources.
                </p>
            </div>
            <div class="col-md-6">
                <img src="~/Content/assets/img/about/about_img.jpg" class="img-fluid" alt="About Image">
            </div>
            <div class="col-md-6">
                <h4>Our Vision</h4>
                <p>
                    To empower job seekers and organizations through innovative solutions,
                    bridging the gap between talent and opportunity.
                </p>
                <h4>Our Mission</h4>
                <p>
                    Deliver seamless recruitment experiences with accuracy, speed, and professionalism.
                </p>
            </div>
        </div>
    </div>
</section>
