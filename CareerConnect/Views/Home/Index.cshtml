@model DatabaseLayer.JobApplysTable
@{
    ViewBag.Title = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/Landing.css" />
}
<!-- Slider Area Start-->
<div class="slider-area">
    <div class="slider-active">
        <div class="single-slider slider-height d-flex align-items-center" data-background="@Url.Content("~/Content/assets/img/hero/h1_hero.jpg")">
            <div class="container">
                <div class="row">
                    <div class="col-xl-6 col-lg-9 col-md-10">
                        <div class="hero__caption">
                            <h1>Find the most exciting startup jobs</h1>
                        </div>
                    </div>
                </div>
                <!-- Search Box -->
                <div class="row">
                    <div class="col-xl-8">
                        <form action="#" class="search-box">
                            <div class="input-form">
                                <input type="text" placeholder="Job Title or keyword">
                            </div>
                            <div class="select-form">
                                <div class="select-itms">
                                    <select name="select" id="select1">
                                        <option value="">Location BD</option>

                                        <option value="">Location US</option>
                                        <option value="">Location UK</option>
                                    </select>
                                </div>
                            </div>
                            <div class="search-form">
                                <a href="@Url.Action("JobApplications", "JobApplication")" class="btn btn-info">Find job</a>

                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Optional welcome message -->
    <div class="container mt-4 text-center">
        @if (Session["UserName"] != null)
        {
            <h2>Welcome, @Session["UserName"] </h2>
        }
    </div>
</div>
<!-- Slider Area End-->
<!-- User Widgets / Quick Links -->
<div class="our-services section-pad-t30">
    <div class="container">
        <div class="row justify-content-center">

            <!-- Profile Card -->
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card shadow-sm text-center p-3">
                    <h4>Profile</h4>
                    <p>View or edit your profile information.</p>
                    <a href="@Url.Action("UserProfile", "User")" class="btn btn-info">Manage Profile</a>
                </div>
            </div>

            <!-- Applications Card -->
            @if (Session["UserTypeID"] != null)
            {
                int userType = (int)Session["UserTypeID"];
                string applicationsUrl = "#";

                if (userType == 3) // Job Seeker
                {
                    applicationsUrl = Url.Action("AppliedJobs", "JobApplication");
                }
                else if (userType == 2) // Job Provider
                {
                    applicationsUrl = Url.Action("JobApplications", "JobApplication");
                }

                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card shadow-sm text-center p-3">
                        <h4>My Applications</h4>
                        <p>Track your job applications and update your reason if needed.</p>
                        <a href="@applicationsUrl" class="btn btn-info">View Applications</a>
                    </div>
                </div>
            }



            <!-- Admin-only Card -->
            @if (Session["UserTypeID"] != null && (int)Session["UserTypeID"] == 1)
            {
                <div class="col-lg-3 col-md-4 mb-4">
                    <div class="card shadow-sm text-center p-3">
                        <h4>All Users</h4>
                        <p>Manage all registered  users.</p>
                        <a href="@Url.Action("AllUsers", "User")" class="btn btn-warning">View Users</a>
                    </div>
                </div>
            }
            @* Job Provider Card *@
            @if (Session["UserTypeID"] != null)
            {
                int userType = (int)Session["UserTypeID"];

                if (userType == 3)  // Job Seeker
                {
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="card shadow-sm text-center p-3">
                            <h4>Available Jobs</h4>
                            <p>Browse and apply for approved job openings.</p>
                            <a href="@Url.Action("JobList", "PostJob")" class="btn btn-success">View Jobs</a>
                        </div>
                    </div>
                }

                if (userType == 2)  // Job Provider
                {
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="card shadow-sm text-center p-3">
                            <h4>Post Job</h4>
                            <p>Create and publish new job openings.</p>
                            <a href="@Url.Action("Create", "PostJob")" class="btn btn-info mb-2">Post a Job</a>
                            <a href="@Url.Action("Index", "PostJob")" class="btn btn-info">View Your Jobs</a>
                        </div>
                    </div>
                }
                else if (userType == 1)  // Admin
                {
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="card shadow-sm text-center p-3">
                            <h4>All Jobs</h4>
                            <p>Manage and review all posted jobs.</p>
                            <a href="@Url.Action("Index", "PostJob")" class="btn btn-info">View All Jobs</a>
                        </div>
                    </div>
                }
            }

            @if (Session["UserTypeID"] != null)
            {
                var userTypeID = (int)Session["UserTypeID"];

                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card shadow-sm text-center p-3">
                        <h4>Companies</h4>
                        <p>Browse all companies</p>

                        <a href="@Url.Action("Index", "Company")" class="btn btn-info mb-2">View Companies</a>

                        @* Show Create button only for Admin or Job Provider *@
                        @if (userTypeID == 1 || userTypeID == 2)
                        {
                            <a href="@Url.Action("Create", "Company")" class="btn btn-success">Create Company</a>
                        }
                    </div>
                </div>
            }





            <!-- You can add more cards if needed -->

        </div>
    </div>
</div>

<!-- The rest of your Home content (Services, Featured Jobs, Blog, Testimonials, etc.) -->
