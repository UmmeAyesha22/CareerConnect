@model IEnumerable<DatabaseLayer.JobApplysTable>
@{
    ViewBag.Title = "My Applications";
}

@section Styles {
    <link rel="stylesheet" href="\Content\assets\css\applied-jobs.css" />
}
<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-6 fw-bold text-dark mb-1">My Applications</h1>
            <p class="text-muted mb-0">Track the status of your job applications</p>
        </div>
        <div class="d-flex align-items-center">
            <div class="badge bg-light text-primary fs-6 px-4 py-2 rounded-pill">
                <i class="fas fa-paper-plane me-2"></i>@(Model?.Count() ?? 0) Applications
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="text-center py-5 my-5">
            <div class="bg-light rounded-circle mx-auto mb-4 d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                <i class="fas fa-search fa-3x text-muted"></i>
            </div>
            <h4 class="text-muted mb-3">No Applications Found</h4>
            <p class="text-muted mb-4">You haven't applied to any jobs yet. Start exploring opportunities!</p>
            <a href="@Url.Action("Index", "Jobs")" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-search me-2"></i>Browse Jobs
            </a>
        </div>
    }
    else
    {
        <!-- Applications List -->
        <div class="applications-container">
            @foreach (var app in Model)
            {
                <div class="application-item mb-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <!-- Job Information -->
                                <div class="col-lg-4 col-md-6 mb-3 mb-lg-0">
                                    <div class="d-flex align-items-center">
                                        <div class="job-icon me-3">
                                            <div class="bg-primary-gradient rounded-3 p-3 d-inline-flex align-items-center justify-content-center">
                                                <i class="fas fa-briefcase text-white"></i>
                                            </div>
                                        </div>
                                        <div class="job-details">
                                            <h5 class="fw-bold text-dark mb-1 job-title" title="@(app.PostJobTable?.JobTitle ?? "Unknown Job")">
                                                @(app.PostJobTable?.JobTitle ?? "Unknown Job")
                                            </h5>
                                            <div class="d-flex align-items-center text-muted">
                                                <i class="fas fa-calendar-alt me-2 small"></i>
                                                <span class="small">Applied: @app.JobApplyDateTime.ToString("dd MMM yyyy")</span>
                                            </div>
                                            <div class="d-flex align-items-center text-muted mt-1">
                                                <i class="fas fa-clock me-2 small"></i>
                                                <span class="small">@app.JobApplyDateTime.ToString("hh:mm tt")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status Column -->
                                <div class="col-lg-3 col-md-6 mb-3 mb-lg-0 text-center">
                                    <div class="status-badge-container">
                                        <span class="status-badge
                                            @(app.JobApplyStatusTable?.JobApplyStatus == "Pending" ? "status-pending" :
                                              app.JobApplyStatusTable?.JobApplyStatus == "Approved" ? "status-approved" :
                                              app.JobApplyStatusTable?.JobApplyStatus == "Cancelled" || app.JobApplyStatusTable?.JobApplyStatus == "Rejected" ? "status-cancelled" :
                                              app.JobApplyStatusTable?.JobApplyStatus == "Shortlisted" ? "status-shortlisted" :
                                              app.JobApplyStatusTable?.JobApplyStatus == "Selected" ? "status-selected" : "status-unknown")">
                                            <i class="fas
                                                @(app.JobApplyStatusTable?.JobApplyStatus == "Pending" ? "fa-clock" :
                                                  app.JobApplyStatusTable?.JobApplyStatus == "Approved" ? "fa-check-circle" :
                                                  app.JobApplyStatusTable?.JobApplyStatus == "Cancelled" || app.JobApplyStatusTable?.JobApplyStatus == "Rejected" ? "fa-times-circle" :
                                                  app.JobApplyStatusTable?.JobApplyStatus == "Shortlisted" ? "fa-star" :
                                                  app.JobApplyStatusTable?.JobApplyStatus == "Selected" ? "fa-trophy" : "fa-question-circle") me-2"></i>
                                            @(app.JobApplyStatusTable?.JobApplyStatus ?? "Unknown Status")
                                        </span>
                                    </div>
                                </div>

                                <!-- Reason/Notes Column -->
                                <div class="col-lg-5 col-md-12">
                                    <div class="reason-container">
                                        <div class="d-flex align-items-start">
                                            <div class="reason-icon me-3 mt-1">
                                                <i class="fas fa-comment-dots text-muted"></i>
                                            </div>
                                            <div class="reason-content">
                                                <h6 class="fw-semibold text-dark mb-1">Update Reason</h6>
                                                <p class="text-muted mb-0 small">
                                                    @if (string.IsNullOrEmpty(app.JobApplyStatusUpdateReason))
                                                    {
                                                        <em class="text-muted">No additional information provided</em>
                                                    }
                                                    else
                                                    {
                                                        @app.JobApplyStatusUpdateReason
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Summary Statistics -->
        <div class="mt-5">
            <div class="row g-4">
                <div class="col-md-3 col-sm-6">
                    <div class="stat-card text-center p-3 rounded-3">
                        <div class="stat-number text-primary fw-bold fs-4">@Model.Count()</div>
                        <div class="stat-label text-muted small">Total Applications</div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-card text-center p-3 rounded-3">
                        <div class="stat-number text-warning fw-bold fs-4">@Model.Count(a => a.JobApplyStatusTable?.JobApplyStatus == "Pending")</div>
                        <div class="stat-label text-muted small">Pending</div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-card text-center p-3 rounded-3">
                        <div class="stat-number text-success fw-bold fs-4">@Model.Count(a => a.JobApplyStatusTable?.JobApplyStatus == "Approved" || a.JobApplyStatusTable?.JobApplyStatus == "Selected")</div>
                        <div class="stat-label text-muted small">Approved/Selected</div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-card text-center p-3 rounded-3">
                        <div class="stat-number text-info fw-bold fs-4">@Model.Count(a => a.JobApplyStatusTable?.JobApplyStatus == "Shortlisted")</div>
                        <div class="stat-label text-muted small">Shortlisted</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-toast position-fixed top-0 start-50 translate-middle-x mt-4" style="z-index: 1060;">
        <div class="alert alert-success shadow-lg border-0 rounded-4 px-4 py-3 d-flex align-items-center">
            <i class="fas fa-check-circle text-success me-3 fa-lg"></i>
            <span class="fw-medium">@TempData["SuccessMessage"]</span>
        </div>
    </div>
}



