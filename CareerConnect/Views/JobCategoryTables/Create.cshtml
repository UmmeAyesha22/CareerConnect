@model DatabaseLayer.JobCategoryTable

@{
    ViewBag.Title = "New Job Category";

    // Check if the user is Admin
    var userType = Session["UserTypeID"] != null ? (int)Session["UserTypeID"] : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/company-create.css" />
}

@if (userType != 1)
{
    <div class="alert alert-warning mt-5 text-center">
        <h4>Unauthorized Access</h4>
        <p>Only Admin users can create new job categories.</p>
    </div>
}
else
{
    <section class="profile-card profile-container p-4">
        <div class="profile-card">
            <div class="card-header text-center">
                <h3 class="card-title">New Job Category</h3>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(model => model.JobCategory, "Job Category", new { @class = "form-label fw-bold" })
                        @Html.EditorFor(model => model.JobCategory, new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control",
                                @placeholder = "Enter Job Category",
                                @required = "true"
                            }
                        })
                        @Html.ValidationMessageFor(model => model.JobCategory, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.Description, "Description", new { @class = "form-label fw-bold" })
                        @Html.EditorFor(model => model.Description, new
                        {
                            htmlAttributes = new
                            {
                                @class = "form-control",
                                @placeholder = "Enter Description",
                                @required = "true"
                            }
                        })
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>
                }
            </div>
        </div>
    </section>
}
