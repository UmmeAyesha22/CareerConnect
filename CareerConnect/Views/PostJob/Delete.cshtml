@model DatabaseLayer.PostJobTable
@{
    ViewBag.Title = "Delete Job";
}
@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/delete-job.css" />
}

<section class="delete-job-container">
    <div class="delete-job-card">
        <h2 class="delete-title text-center mb-4">Delete Job</h2>

        <div class="alert alert-warning delete-alert">
            Are you sure you want to delete this job: <strong>@Model.JobTitle</strong>?
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.CompanyTable.CompanyName</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.JobCategoryTable.JobCategory</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>
        </dl>

        @using (Html.BeginForm("Delete", "PostJob", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.PostJobID)
            <div class="text-center">
                <button type="submit" class="btn btn-danger btn-lg me-2">Delete</button>
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary btn-lg" })
            </div>
        }
    </div>
</section>
