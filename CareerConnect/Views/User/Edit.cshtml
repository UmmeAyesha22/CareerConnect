@model CareerConnect.Models.UserMV
@{
    ViewBag.Title = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Optional, if you have a layout
}

@section Styles {
    <link rel="stylesheet" href="~/Content/assets/css/register.css" />
}

<section class="registration-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow-sm p-4 rounded">
                    <h2 class="text-center mb-4">Edit Profile</h2>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    @* Form to Edit User *@
                    @using (Html.BeginForm("Edit", "User", FormMethod.Post, new { @class = "form-register" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <!-- User Type Dropdown -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.DropDownListFor(model => model.UserTypeID, (SelectList)ViewBag.UserTypeID, "Select User Type", new { @class = "form-select shadow-sm border rounded" })
                                    @Html.ValidationMessageFor(model => model.UserTypeID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- User Name -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control shadow-sm", placeholder = "Enter User Name", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.PasswordFor(model => model.Password, new { htmlAttributes = new { @class = "form-control shadow-sm", placeholder = "Enter Password", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Contact Number -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.EditorFor(model => model.ContactNo, new { htmlAttributes = new { @class = "form-control shadow-sm", placeholder = "Enter Contact No", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.ContactNo, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.EditorFor(model => model.EmailAddress, new { htmlAttributes = new { @class = "form-control shadow-sm", placeholder = "Enter Email", type = "email", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.EmailAddress, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Submit Button Centered -->
                        <div class="text-center mt-4">
                            <input type="submit" value="Save Changes" class="btn" style="background:#b9a8f5; color:white; font-weight:700; padding:16px 50px; border-radius:14px; font-size:16px;" />
                        </div>
                    }

                    <div class="text-center mt-3">
                        <p><a href="@Url.Action("UserProfile", "User")">Back to Profile</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
