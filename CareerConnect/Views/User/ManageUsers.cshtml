@model IEnumerable<DatabaseLayer.UserTable>

@{
    ViewBag.Title = "Manage Users";
}

<h2>Admin - Manage Users</h2>

<div class="section-top-border col-md-10">
    <h3 class="mb-30">Users</h3>

    <div class="progress-table-wrap">
        <div class="progress-table">
            <div class="table-head">
                <div class="serial">#</div>
                <div class="country">Username</div>
                <div class="country">Email</div>
                <div class="country">Contact No</div>
                <div class="country">User Type</div>
                <div class="country">Status</div>
                <div class="country">Action</div>
            </div>

            @foreach (var user in Model)
            {
                <div class="table-row">
                    <div class="serial">@user.UserID</div>
                    <div class="country">@user.UserName</div>
                    <div class="country">@user.EmailAddress</div>
                    <div class="country">@user.ContactNo</div>
                    <div class="country">@user.UserTypeTable?.UserType</div>
                    <div class="country">@user.AccountStatusTable?.StatusName</div>
                    <div class="country">
                        @Html.ActionLink("Edit", "Edit", new { id = user.UserID }, new { @class = "genric-btn primary" })
                        @Html.Raw(" | ")
                        @Html.ActionLink("Delete", "Delete", new { id = user.UserID }, new { @class = "genric-btn danger" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>
